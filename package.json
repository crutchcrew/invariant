{
	"name": "@crutchcrew/invariant",
	"version": "0.1.1",
	"description": "Yet another tiny invariant package for your TypeScript project",
	"keywords": [
		"assert",
		"error",
		"invariant",
		"typescript"
	],
	"homepage": "https://github.com/crutchcrew/invariant#readme",
	"bugs": {
		"url": "https://github.com/crutchcrew/invariant/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crutchcrew/invariant.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun run --parallel build:compile build:declaration",
		"build:compile": "bun build src/index.ts --outdir dist --format esm",
		"build:declaration": "tsc -p tsconfig.build.json --noEmit false",
		"check": "bun run --parallel fmt:check lint lockfile:check",
		"fmt": "oxfmt --write .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lockfile:check": "bun install --frozen-lockfile",
		"prebuild": "rm -rf dist",
		"prepare": "lefthook install",
		"prepublishOnly": "bun run build",
		"test": "bun test",
		"test:coverage": "bun test --coverage"
	},
	"devDependencies": {
		"@tsconfig/bun": "^1.0.11",
		"@types/bun": "^1.4.2",
		"lefthook": "^2.1.12",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "7"
	}
}
